{
  "name": "@dr.pogodin/react-starter",
  "version": "0.0.0",
  "description": "ReactJS Starting Pack by Dr. Pogodin",
  "main": "index.js",
  "scripts": {
    "build": "cross-env ./node_modules/.bin/react-utils-build -t app-production",
    "build:dev": "cross-env ./node_modules/.bin/react-utils-build -t app-development",
    "dev": "rimraf build && concurrently \"typed-scss-modules . -w\" \"cross-env BABEL_ENV=development NODE_ENV=development node --conditions=development ./node_modules/.bin/react-utils-run-with-babel src/server/index.ts\"",
    "jest": "cross-env NODE_CONFIG_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" ./node_modules/.bin/jest --config config/jest/default.js",
    "lint": "npm run lint:code && npm run lint:scss",
    "lint:code": "./node_modules/.bin/eslint --cache --cache-strategy content",
    "lint:scss": "./node_modules/.bin/stylelint **/*.{css,scss}",
    "start": "cross-env NODE_ENV=production node build/server",
    "test": "npm run lint && npm run typecheck && npm run jest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdofpreyru/react-starter.git"
  },
  "keywords": [
    "JavaScript",
    "JS",
    "Dr. Pogodin",
    "React",
    "ReactJS",
    "Starting Pack"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/birdofpreyru/react-starter/issues"
  },
  "homepage": "https://github.com/birdofpreyru/react-starter#readme",
  "engines": {
    "node": ">=24.19"
  },
  "dependencies": {
    "@dr.pogodin/react-utils": "^1.56.5",
    "axios": "^1.20.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@dr.pogodin/babel-plugin-add-import-extension": "^3.0.2",
    "@dr.pogodin/babel-plugin-transform-assets": "^2.0.0",
    "@dr.pogodin/babel-preset-svgr": "^2.0.0",
    "@dr.pogodin/eslint-configs": "^0.3.7",
    "@jest/globals": "^30.5.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@standard-schema/spec": "^1.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/recommended": "^1.0.13",
    "@types/compression": "^1.8.1",
    "@types/config": "^3.3.5",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/pretty": "^2.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/request-ip": "^0.0.41",
    "@types/serialize-javascript": "^5.0.4",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^7.2.1",
    "@types/webpack": "^5.28.5",
    "autoprefixer": "^10.5.5",
    "babel-jest": "^30.5.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "memfs": "^4.71.0",
    "mini-css-extract-plugin": "^2.10.2",
    "mkpath": "^1.0.0",
    "mockdate": "^3.0.5",
    "nodelist-foreach-polyfill": "^1.2.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss-scss": "^4.0.9",
    "pretty": "^2.0.0",
    "react-refresh": "^0.18.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "sitemap": "^9.0.1",
    "source-map-loader": "^5.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.4",
    "tstyche": "^7.2.4",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^6.0.3",
    "webpack": "^5.110.3",
    "webpack-dev-middleware": "^8.3.0",
    "webpack-merge": "^6.0.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "type": "module"
}
