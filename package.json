{
  "name": "@dr.pogodin/react-starter",
  "version": "0.0.0",
  "description": "ReactJS Starting Pack by Dr. Pogodin",
  "main": "index.js",
  "scripts": {
    "build": "cross-env ./node_modules/.bin/react-utils-build -t production --webpack-config webpack.config.ts",
    "build:dev": "cross-env ./node_modules/.bin/react-utils-build -t development --webpack-config webpack.config.ts",
    "build:types-scss": "rimraf build/types-scss && typed-scss-modules .",
    "dev": "rimraf build && concurrently \"typed-scss-modules . -w\" \"cross-env BABEL_ENV=development NODE_ENV=development babel-node --conditions=development --extensions '.ts','.tsx','.svg' src/server\"",
    "fix:js": "./node_modules/.bin/eslint --fix",
    "fix:styles": "./node_modules/.bin/stylelint **/*.scss --syntax scss --fix",
    "jest": "cross-env NODE_CONFIG_ENV=test ./node_modules/.bin/jest --config config/jest/default.js",
    "lint": "npm run lint:js && npm run lint:scss",
    "lint:js": "./node_modules/.bin/eslint",
    "lint:scss": "./node_modules/.bin/stylelint **/*.{css,scss}",
    "start": "cross-env NODE_ENV=production node build/server",
    "test": "npm run build:types-scss && npm run lint && npm run typecheck && npm run jest",
    "typecheck": "npm run build:types-scss && tsc --project __tests__/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdofpreyru/react-starter.git"
  },
  "keywords": [
    "JavaScript",
    "JS",
    "Dr. Pogodin",
    "React",
    "ReactJS",
    "Starting Pack"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/birdofpreyru/react-starter/issues"
  },
  "homepage": "https://github.com/birdofpreyru/react-starter#readme",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10.8"
  },
  "dependencies": {
    "@dr.pogodin/react-utils": "^1.48.13",
    "axios": "^1.13.4",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "react": "^19.2.4",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.28.6",
    "@babel/node": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@dr.pogodin/babel-plugin-transform-assets": "^1.2.5",
    "@dr.pogodin/babel-preset-svgr": "^1.9.2",
    "@dr.pogodin/eslint-configs": "^0.2.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@standard-schema/spec": "^1.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/compression": "^1.8.1",
    "@types/config": "^3.3.5",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/pretty": "^2.0.3",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/request-ip": "^0.0.41",
    "@types/serialize-javascript": "^5.0.4",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^6.0.3",
    "@types/webpack": "^5.28.5",
    "@types/webpack-hot-middleware": "^2.25.12",
    "autoprefixer": "^10.4.23",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-add-import-extension": "^1.6.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.3",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "memfs": "^4.56.10",
    "mini-css-extract-plugin": "^2.10.0",
    "mkpath": "^1.0.0",
    "mockdate": "^3.0.5",
    "nodelist-foreach-polyfill": "^1.2.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-scss": "^4.0.9",
    "pretty": "^2.0.0",
    "react-refresh": "^0.18.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.6",
    "sitemap": "^9.0.0",
    "source-map-loader": "^5.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "supertest": "^7.2.2",
    "tsc-alias": "1.8.16",
    "tstyche": "^6.0.3",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "^6.0.1",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-webpack-plugin": "^7.4.0"
  }
}
